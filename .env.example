# Copy this file to `.env` (local) or add these as "Secrets" on Streamlit Cloud / HF Spaces.

# ---- Required for the default (Groq) backend ----
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---- Optional: pick a different backend ----
# LLM_PROVIDER=groq            # groq | openai | ollama
# GROQ_MODEL=llama-3.3-70b-versatile   # or llama-3.1-8b-instant (faster)

# ---- Optional: OpenAI backend ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Optional: local Ollama backend ----
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
