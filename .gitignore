# Vector store: committed as a prebuilt index so cloud hosts don't have to
# embed documents at startup (avoids out-of-memory on small free tiers).
# (Local rebuilds via the "Rebuild index" button will update these files.)

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# FastEmbed model cache
.fastembed_cache/

